{
  "name": "guide-watcher",
  "version": "2.0.0",
  "description": "Auto-generate study guides from lecture PDFs",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "test": "npm run test:frontend && npm run test:rust",
    "test:frontend": "node --test src/lib/*.test.js src/stores/*.test.js",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:ui": "node tests/ui.test.mjs && node tests/history-management.test.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "playwright": "^1.62.1",
    "svelte": "^5.57.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  }
}
